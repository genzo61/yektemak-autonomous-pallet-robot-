    <!-- ================================================= -->
    <!-- WATER SECTION                                     -->
    <!-- Visual only for now                               -->
    <!-- ================================================= -->

    <model name="water_zone">
      <static>true</static>

      <pose>14 0 0.01 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>4.0 4.0 0.02</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.2 0.8 0.65</ambient>
            <diffuse>0.05 0.2 0.8 0.65</diffuse>
          </material>

        </visual>

      </link>
    </model>


