    <!-- UPHILL RAMP                                       -->
    <!-- ================================================= -->

    <model name="slope">

      <static>true</static>

      <!-- ~10 degree incline -->
      <pose>23 0 0.43 0 -0.1745 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 3.0 0.15</size>
