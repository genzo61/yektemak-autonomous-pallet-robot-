    <!-- ================================================= -->
    <!-- VERTICAL OBSTACLE                                 -->
    <!-- ================================================= -->

    <model name="vertical_obstacle">
      <static>true</static>

      <pose>11 0 0.075 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
