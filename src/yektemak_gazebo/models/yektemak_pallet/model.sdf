<?xml version="1.0"?>
<!-- Yektemak palet modeli: 1.20 x 0.80 m, iki raylı, üstünde yük.
     Rayların iç aralığı 0.60 m; robot (tekerlerle 0.48 m) bu boşluğa girer.
