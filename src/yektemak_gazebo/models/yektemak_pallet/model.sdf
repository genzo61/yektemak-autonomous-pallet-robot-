<?xml version="1.0"?>

<sdf version="1.6">

  <model name="yektemak_pallet">

    <static>false</static>

    <link name="pallet_link">

      <inertial>
        <pose>0 0 0.15 0 0 0</pose>

        <mass>25.0</mass>

        <inertia>
          <ixx>1.50</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>3.10</iyy>
          <iyz>0.0</iyz>
          <izz>4.40</izz>
        </inertia>
      </inertial>

      <!-- Sol taşıyıcı ray -->

      <collision name="left_runner_collision">
        <pose>0 0.34 0.115 0 0 0</pose>

        <geometry>
          <box>
            <size>1.10 0.08 0.23</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="left_runner_visual">
        <pose>0 0.34 0.115 0 0 0</pose>

        <geometry>
          <box>
            <size>1.10 0.08 0.23</size>
          </box>
        </geometry>

        <material>
          <ambient>0.42 0.22 0.08 1</ambient>
          <diffuse>0.55 0.30 0.10 1</diffuse>
        </material>
      </visual>

      <!-- Sağ taşıyıcı ray -->

      <collision name="right_runner_collision">
        <pose>0 -0.34 0.115 0 0 0</pose>

        <geometry>
          <box>
            <size>1.10 0.08 0.23</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="right_runner_visual">
        <pose>0 -0.34 0.115 0 0 0</pose>

        <geometry>
          <box>
            <size>1.10 0.08 0.23</size>
          </box>
        </geometry>

        <material>
          <ambient>0.42 0.22 0.08 1</ambient>
          <diffuse>0.55 0.30 0.10 1</diffuse>
        </material>
      </visual>

      <!-- Üst palet tablası -->

      <collision name="top_deck_collision">
        <pose>0 0 0.25 0 0 0</pose>

        <geometry>
          <box>
            <size>1.20 0.80 0.04</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="top_deck_visual">
        <pose>0 0 0.25 0 0 0</pose>

        <geometry>
          <box>
            <size>1.20 0.80 0.04</size>
          </box>
        </geometry>

        <material>
          <ambient>0.58 0.32 0.12 1</ambient>
          <diffuse>0.72 0.43 0.18 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>