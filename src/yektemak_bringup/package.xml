<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>yektemak_bringup</name>

  <version>0.0.1</version>

  <description>
    EVRENOS real vehicle hardware bringup and integration package.
  </description>

  <maintainer email="haydar.ali61@hotmail.com">
    ali
  </maintainer>

  <license>Apache-2.0</license>


  <!-- Build -->
  <buildtool_depend>ament_cmake</buildtool_depend>


  <!-- ROS2 -->
  <exec_depend>rclpy</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>


  <!-- Serial communication -->
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>yektemak_description</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>yektemak_navigation</exec_depend>
  <!-- Tests -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>