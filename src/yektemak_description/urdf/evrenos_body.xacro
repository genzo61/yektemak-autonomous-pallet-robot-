<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    EVRENOS EVR-03 approximate visual body.

    +X = FRONT
    -X = REAR
    +Y = LEFT
    +Z = UP

    This is currently a visual approximation of the KTR CAD model.
    Physical collision remains simplified in base_link.
  -->

  <!-- Main upper body -->
  <link name="body_link">

    <!-- Center armored body -->
    <visual>
      <origin xyz="-0.05 0 0.10" rpy="0 0 0"/>

      <geometry>
        <box size="0.68 0.74 0.22"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Front sloped armor -->
    <visual>
      <origin xyz="0.34 0 0.055" rpy="0 -0.30 0"/>

      <geometry>
        <box size="0.42 0.74 0.17"/>
      </geometry>

      <material name="evrenos_metal"/>
    </visual>


    <!-- Rear upper armor -->
    <visual>
      <origin xyz="-0.39 0 0.06" rpy="0 0.20 0"/>

      <geometry>
        <box size="0.30 0.72 0.17"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Roof -->
    <visual>
      <origin xyz="-0.05 0 0.235" rpy="0 0 0"/>

      <geometry>
        <box size="0.54 0.58 0.06"/>
      </geometry>

      <material name="evrenos_dark"/>
    </visual>


    <!-- Front center armor panel -->
    <visual>
      <origin xyz="0.50 0 0.015" rpy="0 -0.35 0"/>

      <geometry>
        <box size="0.18 0.60 0.12"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Front left lamp -->
    <visual>
      <origin xyz="0.575 0.20 0.015" rpy="0 0 0"/>

      <geometry>
        <box size="0.035 0.11 0.07"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>


    <!-- Front center lamp -->
    <visual>
      <origin xyz="0.575 0 0.015" rpy="0 0 0"/>

      <geometry>
        <box size="0.035 0.11 0.07"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>


    <!-- Front right lamp -->
    <visual>
      <origin xyz="0.575 -0.20 0.015" rpy="0 0 0"/>

      <geometry>
        <box size="0.035 0.11 0.07"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>

  </link>


  <!--
    body_link is attached to the chassis.
    base_link center is inside the lower chassis.
  -->
  <joint name="body_joint" type="fixed">

    <parent link="base_link"/>
    <child link="body_link"/>

    <origin
      xyz="0 0 ${base_height / 2.0 + 0.08}"
      rpy="0 0 0"/>

  </joint>

</robot>

