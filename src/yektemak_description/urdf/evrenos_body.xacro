<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    EVRENOS EVR-03 approximate visual body.

    +X = FRONT
    -X = REAR
    +Y = LEFT
    +Z = UP

    This is currently a visual approximation of the KTR CAD model.
    Physical collision remains simplified in base_link.
  -->

  <!-- Main upper body -->
  <link name="body_link">

    <!-- Center armored body -->
    <visual>
      <origin xyz="${-0.05 * vehicle_scale} 0 ${0.10 * vehicle_scale}" rpy="0 0 0"/>

      <geometry>
        <box size="${0.68 * vehicle_scale} ${0.74 * vehicle_scale} ${0.22 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Front sloped armor -->
    <visual>
      <origin xyz="${0.34 * vehicle_scale} 0 ${0.055 * vehicle_scale}" rpy="0 -0.30 0"/>

      <geometry>
        <box size="${0.42 * vehicle_scale} ${0.74 * vehicle_scale} ${0.17 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_metal"/>
    </visual>


    <!-- Rear upper armor -->
    <visual>
      <origin xyz="${-0.39 * vehicle_scale} 0 ${0.06 * vehicle_scale}" rpy="0 0.20 0"/>

      <geometry>
        <box size="${0.30 * vehicle_scale} ${0.72 * vehicle_scale} ${0.17 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Roof -->
    <visual>
      <origin xyz="${-0.05 * vehicle_scale} 0 ${0.235 * vehicle_scale}" rpy="0 0 0"/>

      <geometry>
        <box size="${0.54 * vehicle_scale} ${0.58 * vehicle_scale} ${0.06 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_dark"/>
    </visual>


    <!-- Front center armor panel -->
    <visual>
      <origin xyz="${0.50 * vehicle_scale} 0 ${0.015 * vehicle_scale}" rpy="0 -0.35 0"/>

      <geometry>
        <box size="${0.18 * vehicle_scale} ${0.60 * vehicle_scale} ${0.12 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_body"/>
    </visual>


    <!-- Front left lamp -->
    <visual>
      <origin xyz="${0.575 * vehicle_scale} ${0.20 * vehicle_scale} ${0.015 * vehicle_scale}" rpy="0 0 0"/>

      <geometry>
        <box size="${0.035 * vehicle_scale} ${0.11 * vehicle_scale} ${0.07 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>


    <!-- Front center lamp -->
    <visual>
      <origin xyz="${0.575 * vehicle_scale} 0 ${0.015 * vehicle_scale}" rpy="0 0 0"/>

      <geometry>
        <box size="${0.035 * vehicle_scale} ${0.11 * vehicle_scale} ${0.07 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>


    <!-- Front right lamp -->
    <visual>
      <origin xyz="${0.575 * vehicle_scale} ${-0.20 * vehicle_scale} ${0.015 * vehicle_scale}" rpy="0 0 0"/>

      <geometry>
        <box size="${0.035 * vehicle_scale} ${0.11 * vehicle_scale} ${0.07 * vehicle_scale}"/>
      </geometry>

      <material name="evrenos_light"/>
    </visual>

  </link>


  <!--
    body_link is attached to the chassis.
    base_link center is inside the lower chassis.
  -->
  <joint name="body_joint" type="fixed">

    <parent link="base_link"/>
    <child link="body_link"/>

    <origin
      xyz="0 0 ${base_height / 2.0 + 0.08 * vehicle_scale}"
      rpy="0 0 0"/>

  </joint>

</robot>
