<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    4 kose LiDAR duzeni (liman senaryosu)
    Her kosede bir 2D LiDAR, kosegen yone bakar ve 270 derece gorur.
    Komsu LiDARlar ortusur, robotun etrafinda kor nokta kalmaz.
    Dort tarama yektemak_tasks/scan_merger ile tek 360 derece taramada birlesir.
    Yukseklik on/arka duzendeki gibi 11 cm - paleti 17 cm kaldirinca raylar
    tarama duzleminin ustunde kalir.
  -->

  <xacro:property name="corner_x" value="${base_length / 2.0 + 0.07}"/>
  <xacro:property name="corner_y" value="0.17"/>
  <xacro:property name="corner_fov" value="2.356194"/>  <!-- +-135 derece -->

  <xacro:macro name="corner_lidar" params="name x y yaw">
    <link name="${name}_lidar_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
        </geometry>
        <material name="yektemak_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_lidar_link"/>
      <origin xyz="${x} ${y} ${lidar_height_from_ground - (base_ground_clearance + base_height / 2.0)}"
              rpy="0 0 ${yaw}"/>
    </joint>

    <xacro:if value="$(arg use_sim)">
      <gazebo reference="${name}_lidar_link">
        <material>Gazebo/FlatBlack</material>
        <sensor name="${ns}${name}_lidar" type="ray">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>10.0</update_rate>
          <pose>0 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>361</samples>
                <resolution>1</resolution>
                <min_angle>${-corner_fov}</min_angle>
                <max_angle>${corner_fov}</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.10</min>
              <max>25.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.008</stddev>
            </noise>
          </ray>
          <plugin name="${ns}${name}_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <remapping>~/out:=${'/' + ns if ns else ''}/scan_${name}_raw</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>${prefix}${name}_lidar_link</frame_name>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:corner_lidar name="front_left" x="${corner_x}" y="${corner_y}" yaw="${pi / 4}"/>
  <xacro:corner_lidar name="front_right" x="${corner_x}" y="${-corner_y}" yaw="${-pi / 4}"/>
  <xacro:corner_lidar name="rear_left" x="${-corner_x}" y="${corner_y}" yaw="${3 * pi / 4}"/>
  <xacro:corner_lidar name="rear_right" x="${-corner_x}" y="${-corner_y}" yaw="${-3 * pi / 4}"/>

</robot>
