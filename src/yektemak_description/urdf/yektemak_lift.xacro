<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Kaldırma platformu ölçüleri -->
  <xacro:property name="lift_platform_length" value="0.90"/>
  <xacro:property name="lift_platform_width" value="0.60"/>
  <xacro:property name="lift_platform_height" value="0.05"/>

  <xacro:property name="lift_platform_mass" value="8.0"/>
  <xacro:property name="lift_platform_clearance" value="0.02"/>
  <xacro:property name="lift_max_height" value="0.20"/>

  <!-- Paleti kaldıracak üst platform -->
  <link name="lift_platform_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="
          ${lift_platform_length}
          ${lift_platform_width}
          ${lift_platform_height}"/>
      </geometry>

      <material name="yektemak_yellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="
          ${lift_platform_length}
          ${lift_platform_width}
          ${lift_platform_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${lift_platform_mass}"/>

      <inertia
        ixx="${lift_platform_mass *
          (lift_platform_width * lift_platform_width +
           lift_platform_height * lift_platform_height) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${lift_platform_mass *
          (lift_platform_length * lift_platform_length +
           lift_platform_height * lift_platform_height) / 12.0}"
        iyz="0.0"
        izz="${lift_platform_mass *
          (lift_platform_length * lift_platform_length +
           lift_platform_width * lift_platform_width) / 12.0}"/>
    </inertial>

  </link>

  <!-- Platform yalnızca Z ekseninde hareket eder -->
  <joint name="lift_platform_joint" type="prismatic">

    <parent link="base_link"/>
    <child link="lift_platform_link"/>

    <origin
      xyz="0 0 ${base_height / 2.0 +
                 lift_platform_height / 2.0 +
                 lift_platform_clearance}"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="${lift_max_height}"
      effort="2000.0"
      velocity="0.10"/>

    <dynamics
      damping="5.0"
      friction="1.0"/>

  </joint>

</robot>