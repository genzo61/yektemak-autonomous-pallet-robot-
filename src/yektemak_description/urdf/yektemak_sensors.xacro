<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Sensör yerleşimi
    +X = ön, +Y = sol, +Z = yukarı

    LiDAR bilerek ALÇAĞA (yerden ~11 cm) ve ön tampona konuldu
    robot paleti kaldırdığında palet tablası LiDARin üstünde kalır,
    böylece yüklüyken de robot görmeye devam eder. Paletin rayları
    scan içinde görünür; bunlar laser_filters ile temizlenir.
  -->

  <xacro:property name="lidar_height_from_ground" value="0.11"/>
  <xacro:property name="lidar_x" value="${base_length / 2.0 + 0.07}"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_length" value="0.05"/>

  <!-- LiDAR tutucu braketi (görsel) -->
  <link name="lidar_bracket_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.08 0.02"/>
      </geometry>
      <material name="yektemak_gray"/>
    </visual>
  </link>

  <joint name="lidar_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_bracket_link"/>
    <origin
      xyz="${base_length / 2.0 + 0.035} 0
           ${lidar_height_from_ground - lidar_length / 2.0 - 0.01
             - (base_ground_clearance + base_height / 2.0)}"
      rpy="0 0 0"/>
  </joint>

  <!-- 2D LiDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="yektemak_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin
      xyz="${lidar_x} 0
           ${lidar_height_from_ground - (base_ground_clearance + base_height / 2.0)}"
      rpy="0 0 0"/>
  </joint>

  <!-- IMU - gövde merkezinde -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.01"/>
      </geometry>
      <material name="yektemak_red"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.005}" rpy="0 0 0"/>
  </joint>

</robot>
