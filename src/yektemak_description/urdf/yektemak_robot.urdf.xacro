<?xml version="1.0"?>

<robot
  name="yektemak_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Renk tanımları -->
  <xacro:include filename="yektemak_materials.xacro"/>

  <!-- Ana gövde -->
  <xacro:include filename="yektemak_base.xacro"/>

  <!-- Dört teker -->
  <xacro:include filename="yektemak_wheels.xacro"/>

  <!-- Palet kaldırma platformu -->
  <xacro:include filename="yektemak_lift.xacro"/>

  <!-- Ön yön işareti -->
  <xacro:include filename="yektemak_markers.xacro"/>

    <!-- Gazebo fizik ve görünüm ayarları -->
  <xacro:include filename="yektemak_gazebo.xacro"/>

</robot>